# رشته اتصال دیتابیس MySQL (TiDB Cloud Serverless — الزامی TLS دارد)
DATABASE_URL=mysql://USER:PASSWORD@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/classroom_ledger?ssl=%7B%22minVersion%22%3A%22TLSv1.2%22%7D

# کلید امضای JWT سشن (حداقل ۳۲ کاراکتر تصادفی)
JWT_SECRET=change-me-to-a-long-random-string

# اعتبارنامه ورود مدیر
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# محیط اجرا
NODE_ENV=production
